      "position": [1000, 800]
    },
    {
      "parameters": {
        "conditions": {
          "options": [
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "unknown", "operator": { "type": "string", "operation": "notEquals" } }
              ],
              "renameOutput": true,
              "outputKey": "known"
            }
          ],
          "fallbackOutput": "unknown"
        }
      },
      "id": "check-result",
      "name": "Check Result",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/functions/v1/n8n-callback",
        "method": "POST",
        "sendBody": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-GH-Signature", "value": "={{ $json.signature || '' }}" },
            { "name": "X-GH-Timestamp", "value": "={{ Date.now() }}" },
            { "name": "X-GH-Correlation-Id", "value": "={{ $json.correlation_id || '' }}" }
          ]
        },
        "bodyParameters": {
          "parameters": [
            { "name": "run_id", "value": "={{ $json.run_id }}" },
            { "name": "status", "value": "={{ $json.status || 'completed' }}" },
            { "name": "result", "value": "={{ JSON.stringify($json) }}" },
            { "name": "agent_key", "value": "={{ $json.agent_key }}" },
            { "name": "company_id", "value": "={{ $json.company_id }}" },
            { "name": "event_type", "value": "={{ $json.event_type }}" }
          ]
        }
      },
      "id": "send-callback-success",
      "name": "Send Success Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/functions/v1/n8n-callback",
        "method": "POST",
        "sendBody": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-GH-Timestamp", "value": "={{ Date.now() }}" },
            { "name": "X-GH-Correlation-Id", "value": "={{ $json.correlation_id || '' }}" }
          ]
        },
        "bodyParameters": {
          "parameters": [
            { "name": "run_id", "value": "={{ $json.run_id }}" },
            { "name": "status", "value": "failed" },
            { "name": "error", "value": "Unknown agent or workflow not found" },
            { "name": "agent_key", "value": "={{ $json.agent_key || 'unknown' }}" },
            { "name": "company_id", "value": "={{ $json.company_id }}" }
          ]
        }
      },
      "id": "send-callback-failure",
      "name": "Send Failure Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1500, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { received: true, correlation_id: $json.correlation_id } }}"
      },
      "id": "response-node",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1750, 300]
    }
