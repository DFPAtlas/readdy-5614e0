{
  "name": "GuardianHub Orchestrator",
  "version": "1.0.0",
  "description": "Master workflow that receives signed gateway requests and routes to correct agent workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orchestrator",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Gateway Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Verify HMAC signature\nconst crypto = require('crypto');\nconst secret = process.env.N8N_GUARDIANHUB_SIGNING_SECRET || '';\nconst signature = $input.first().json.headers['x-gh-signature'] || '';\nconst timestamp = $input.first().json.headers['x-gh-timestamp'] || '';\nconst nonce = $input.first().json.headers['x-gh-nonce'] || '';\n\nconst body = $input.first().json.body;\nconst payloadStr = JSON.stringify(body);\n\nconst expectedSig = crypto.createHmac('sha256', secret).update(payloadStr).digest('hex');\n\nconst now = Date.now();\nconst ts = parseInt(timestamp);\nconst isExpired = Math.abs(now - ts) > 5 * 60 * 1000;\n\nif (signature !== expectedSig || isExpired) {\n  throw new Error('Invalid signature or expired request');\n}\n\nconst receivedNonces = $getWorkflowStaticData('global').nonces || [];\nif (receivedNonces.includes(nonce)) {\n  throw new Error('Replayed nonce detected');\n}\nreceivedNonces.push(nonce);\nif (receivedNonces.length > 10000) receivedNonces.shift();\n$getWorkflowStaticData('global').nonces = receivedNonces;\n\nreturn {\n  json: {\n    verified: true,\n    agent_key: body.agent_key,\n    event_type: body.event_type,\n    company_id: body.company_id,\n    correlation_id: body.correlation_id,\n    run_id: body.run_id,\n    payload: body\n  }\n};"
      },
      "id": "verify-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": [
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "incident_triage", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "incident_triage"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "sos_escalation", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "sos_escalation"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "attendance_exceptions", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "attendance_exceptions"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "rota_assistance", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "rota_assistance"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "compliance_monitoring", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "compliance_monitoring"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "report_generation", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "report_generation"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "notification_escalation", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "notification_escalation"
            },
            {
              "conditions": [
                { "leftValue": "={{ $json.agent_key }}", "rightValue": "automation_health", "operator": { "type": "string", "operation": "equals" } }
              ],
              "renameOutput": true,
              "outputKey": "automation_health"
            }
          ]
        }
      },
      "id": "route-by-agent",
      "name": "Route by Agent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [750, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_GUARDIANHUB_BASE_URL }}/webhook/incident-triage",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "body", "value": "={{ JSON.stringify($json.payload) }}" }
          ]
        }
      },
      "id": "exec-incident-triage",
      "name": "Execute Incident Triage",
